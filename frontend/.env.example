# ── Backend URL ──────────────────────────────────────────────────────────────
# Full URL of the Express backend this frontend talks to.
# The VITE_ prefix is required — Vite only exposes variables with this prefix
# to the browser bundle. Never put secrets here — everything here is public.
#
# Development:  http://localhost:4000
# Production:   https://your-backend.onrender.com
VITE_BACKEND_URL=http://localhost:4000

# ── Payments ─────────────────────────────────────────────────────────────────
# Razorpay public key used to open the payment modal in the browser.
# This is safe to expose — it is the PUBLIC key, not the secret.
# Must match the RAZORPAY_KEY_ID in the backend .env.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
