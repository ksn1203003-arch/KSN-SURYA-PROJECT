# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string. For local development use the default below.
# For production use your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/teachscript

# ── Authentication ───────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Must be at least 32 random characters.
# Generate one with: openssl rand -hex 32
# Changing this logs out ALL users immediately — all existing tokens become invalid.
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on. Default is 4000.
PORT=4000

# Full URL of your frontend — used for CORS and email links.
# In production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Full URL of this backend — used in outbound email links.
# In production: https://your-backend.onrender.com
BACKEND_URL=http://localhost:4000

# ── AI Assistant ─────────────────────────────────────────────────────────────
# Anthropic API key for the Claude-powered lesson assistant.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxx

# ── Signup Approval ──────────────────────────────────────────────────────────
# HMAC secret used to sign school signup approval/rejection email links.
# Generate one with: openssl rand -hex 32
# If missing, the signup approval flow will not work.
APPROVAL_SECRET=change-this-to-another-long-random-string

# ── Email ────────────────────────────────────────────────────────────────────
# Resend API key for sending transactional emails (invites, password resets).
# Get one at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# The "From" address shown on all outbound emails.
FROM_EMAIL=onboarding@resend.dev

# Admin email that receives new school signup notifications.
OWNER_EMAIL=admin@yourschool.com

# ── Payments ─────────────────────────────────────────────────────────────────
# Razorpay credentials for subscription upgrades.
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) in development, live keys in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# WhatsApp Business API credentials for sending notifications.
# Optional — the app works without these, just no WhatsApp messages.
WHATSAPP_API_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL. Used for distributed auth cache (Sprint 3+).
# Optional in development — the server uses an in-process cache fallback.
# In production with multiple Node processes, Redis is required for correctness.
# Get a free instance at: https://upstash.com or run locally: docker run -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN for error tracking and performance monitoring.
# Get one at: https://sentry.io — leave blank to disable Sentry.
# SENTRY_DSN=https://xxxxxxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Log level for pino. Defaults to "debug" in development, "info" in production.
# Valid values: trace, debug, info, warn, error, fatal
# LOG_LEVEL=info

# ── Environment ──────────────────────────────────────────────────────────────
# Set to "production" on your server. Controls validation strictness and
# whether stack traces are shown in error responses.
NODE_ENV=development
